namespace midi2pwm.pwm;

// Command envelope for manipulating fault handling behaviour.

enum FaultControlOperation : ubyte {
  Reset = 0,
  Fetch = 1,
  EnableAutoReset = 2,
  DisableAutoReset = 3
}

table FaultControlCommand {
  operation: FaultControlOperation;
  channel_number: uint16;
}

root_type FaultControlCommand;
file_identifier "PWFC";
