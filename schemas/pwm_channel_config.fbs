include "pwm_types.fbs";
include "pwm_output_modes.fbs";

namespace midi2pwm.pwm;

// Static configuration describing how a PWM output channel is programmed.

table ChannelConfig {
  channel_number: uint16;
  configuration: ChannelConfiguration = FullBridge;
  note: uint16;
  midpoint: float;    // DEPRECATED: No longer used by firmware, will be removed in future version
  min_point: float;   // DEPRECATED: No longer used by firmware, will be removed in future version
  max_point: float;   // DEPRECATED: No longer used by firmware, will be removed in future version

  // Output mode configuration
  output_mode: OutputModeType = Instant;
  mode_params: ModeParametersUnion;
}

root_type ChannelConfig;
file_identifier "PWCF";
