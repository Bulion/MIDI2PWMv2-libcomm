namespace midi2pwm.pwm;

enum OutputModeType : byte {
  Instant = 0,
  Ramped = 1,
  Pulse = 2,
  Toggle = 3,
  ADSR = 4,
  CCControl = 5,
  PitchBend = 6
}

table InstantModeParams {
  on_level: ubyte = 255;
  velocity_sensitive: bool = true;
}

table RampedModeParams {
  on_level: ubyte = 255;
  velocity_sensitive: bool = true;
  attack_time_ms: uint16 = 100;
  release_time_ms: uint16 = 100;
}

table PulseModeParams {
  on_level: ubyte = 255;
  velocity_sensitive: bool = true;
  attack_time_ms: uint16 = 10;
  hold_time_ms: uint16 = 100;
  release_time_ms: uint16 = 50;
}

table ToggleModeParams {
  on_level: ubyte = 255;
  velocity_sensitive: bool = false;
  debounce_delay_ms: uint16 = 50;
}

table ADSRModeParams {
  attack_level: ubyte = 255;
  sustain_level: ubyte = 200;
  velocity_sensitive: bool = true;
  attack_time_ms: uint16 = 50;
  decay_time_ms: uint16 = 100;
  release_time_ms: uint16 = 200;
}

table CCControlModeParams {
  cc_number: ubyte = 1;
  center_value: ubyte = 64;
  left_max_pwm: ubyte = 255;
  right_max_pwm: ubyte = 255;
  deadband_range: ubyte = 2;
}

table PitchBendModeParams {
  base_level: ubyte = 128;
  bend_range: ubyte = 64;
  unipolar: bool = false;
  velocity_sensitive: bool = true;
}

union ModeParametersUnion {
  InstantModeParams,
  RampedModeParams,
  PulseModeParams,
  ToggleModeParams,
  ADSRModeParams,
  CCControlModeParams,
  PitchBendModeParams
}
